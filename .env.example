# ============================================================
# Configuração do Sistema de Consulta Veterinária
# Copie para .env e ajuste conforme necessário.
# ============================================================

# ---- Modo de execução: local | docker | server
APP_MODE=local
APP_DEBUG=false

# ---- Ollama
# Local (host):     http://127.0.0.1:11434
# Docker compose:   http://ollama:11434
# Servidor remoto:  http://ollama.universidade.pt:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=1000

# ---- MedVet
MEDVET_BASE_URL=https://medvet.dgav.pt
MEDVET_MAX_RESULTS=10
MEDVET_CONCURRENT=5
# Selenium permanece como fallback se o GET HTTP direto não funcionar.
SELENIUM_ENABLED=true
SELENIUM_HEADLESS=true

# ---- API
API_HOST=0.0.0.0
API_PORT=5000
# Em produção restringir aos domínios da faculdade:
# CORS_ORIGINS=https://chatbot.universidade.pt,https://api.universidade.pt
CORS_ORIGINS=*
API_WORKERS=1

# ---- Cache TTLs (segundos)
CACHE_TTL_CLASSIFICATION=604800
CACHE_TTL_SEARCH=86400
CACHE_TTL_HTML=604800
CACHE_TTL_RESPONSE=86400

# ---- Limites e retrieval (v2.1)
# Subiu de 12000 → 30000 com GPUs >16GB e modelos 32k+ contexto
CONTEXT_CHARS_LIMIT=30000
MAX_PDF_PAGES=20
RETRIEVER_TOP_K=8
# Activa RAG denso (embeddings via Ollama). Cai para BM25 puro se modelo
# embed (OLLAMA_EMBED_MODEL) não estiver instalado.
RETRIEVER_USE_EMBEDDINGS=true
# Threshold cosine: chunks denso abaixo deste valor são ignorados
RETRIEVER_DENSE_MIN_SIM=0.30
# Confiança mínima da resposta LLM. Abaixo disto, re-prompta com mais contexto
ANSWER_MIN_CONFIDENCE=0.55
# Quanto alargar top-k ao re-promptar (P4)
REPROMPT_EXPAND_FACTOR=2
